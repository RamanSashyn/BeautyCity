# Скопируйте файл в .env и заполните значения. Файл .env в репозиторий не попадает.

# Django
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Krasnoyarsk
LANGUAGE_CODE=ru-ru

# База данных. Для запуска без Docker:
# DATABASE_URL=sqlite:///db.sqlite3
# В docker compose адрес собирается из переменных POSTGRES_* ниже.
POSTGRES_DB=beautycity
POSTGRES_USER=beautycity
POSTGRES_PASSWORD=замените-на-пароль

# Ключи Яндекс.Карт: https://developer.tech.yandex.ru/services/
YANDEX_GEOCODE_KEY=
YANDEX_STATICMAP_KEY=

# Отправка SMS с кодом входа. По умолчанию код пишется в лог, SMS не уходит.
# Чтобы подключить провайдера, укажите путь к своему классу-наследнику SmsSender.
# SMS_SENDER=api.services.sms.ConsoleSmsSender
